{
  "contractVersion": "1.0.0",
  "environment": "production",
  "requiredCapabilities": [
    "request-context", "panic-recovery", "request-id", "trace-context",
    "structured-logging", "metrics-red", "deadline-timeout", "payload-limit",
    "rate-limit", "auth", "json", "headers", "compression",
    "tls-policy", "security-headers", "idempotency", "content-negotiation",
    "fault-injection", "test-auth-bypass", "schema-capture"
  ],
  "settings": {
    "requestIdHeader": "x-request-id",
    "traceHeader": "traceparent",
    "timeoutMs": 15000,
    "maxBodyBytes": 1048576,
    "contextRegistryMaxEntries": 10000,
    "contextRegistryTtlMs": 30000,
    "rateLimit": {
      "enabled": true,
      "capacity": 120,
      "refillPerSecond": 2.0,
      "keyBy": ["ip", "route"],
      "policyId": "web-default",
      "algorithm": "token-bucket",
      "layer": "application",
      "failureMode": "fail-closed",
      "windowMs": 60000,
      "localCacheMaxEntries": 10000,
      "localCacheTtlMs": 60000,
      "keyNamespace": "eal-web-server:web-default",
      "keyVersion": "v1",
      "keyDerivation": "external-hmac-sha256"
    },
    "compression": {"enabled": true, "minimumBytes": 1024, "algorithms": ["br", "gzip"]},
    "tls": {
      "mode": "trusted-proxy",
      "requireHttps": true,
      "strictForwardedHeaders": true,
      "trustedProxyCidrs": ["127.0.0.1/32", "::1/128"]
    },
    "securityHeaders": {
      "enabled": true,
      "hstsMaxAgeSeconds": 31536000,
      "contentSecurityPolicy": "default-src 'none'; style-src 'self'; script-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'",
      "frameOptions": "DENY"
    },
    "idempotency": {
      "enabled": false,
      "headerName": "idempotency-key",
      "ttlSeconds": 86400,
      "requiredMethods": []
    },
    "faultInjection": {"enabled": false, "latencyMs": 0, "errorRate": 0.0, "dropRate": 0.0},
    "testAuthBypass": {"enabled": false, "headerName": "x-ores-test-auth-bypass", "allowedCidrs": ["127.0.0.1/32", "::1/128"]},
    "contentRepresentations": ["text/html", "application/json", "application/problem+json"]
  },
  "integrations": {
    "sharedAuth": {"mode": "disabled", "failOpen": false},
    "optoSync": {"mode": "disabled", "failOpen": false},
    "oresOtel": {"enabled": true, "serviceName": "eal-web-server", "propagators": ["tracecontext", "baggage"]}
  }
}
